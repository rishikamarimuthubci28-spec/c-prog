#include <stdio.h>

// Recursive function to calculate the nth term
int find_nth_term(int n, int a, int b, int c) {
    // Base cases
    if (n == 1) return a;
    if (n == 2) return b;
    if (n == 3) return c;
    
    // Recursive step: sum of the previous three terms
    return find_nth_term(n - 1, a, b, c) + 
           find_nth_term(n - 2, a, b, c) + 
           find_nth_term(n - 3, a, b, c);
}

int main() {
    int n, a, b, c;
  
    // Read the term index n and the first three terms a, b, c
    if (scanf("%d", &n) != 1) return 1;
    if (scanf("%d %d %d", &a, &b, &c) != 3) return 1;
    
    // Calculate and print the nth term
    int ans = find_nth_term(n, a, b, c);
    printf("%d\n", ans);
    
    return 0;
}
