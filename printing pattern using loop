#include <stdio.h>

int main() {
    int n;
    
    // Read the input value
    if (scanf("%d", &n) != 1) return 1;
    
    // The size of the grid is always (2*n - 1) by (2*n - 1)
    int size = 2 * n - 1;
    
    // Nested loops to iterate through rows and columns
    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            // Find the minimum distance from the current position to any of the four edges
            int min_dist = i;
            if (j < min_dist) min_dist = j;
            if (size - 1 - i < min_dist) min_dist = size - 1 - i;
            if (size - 1 - j < min_dist) min_dist = size - 1 - j;
            
            // Print the value based on the minimum distance
            printf("%d ", n - min_dist);
        }
        printf("\n");
    }
    
    return 0;
}
