#include <stdio.h>

int main() {
    // 1. Declare 4 variables: two int and two float
    int int1, int2;
    float float1, float2;
    
    // 2. Read 2 lines of input from stdin
    scanf("%d %d", &int1, &int2);
    scanf("%f %f", &float1, &float2);
    
    // 3. Print the results according to the Output Format
    printf("%d %d\n", int1 + int2, int1 - int2);
    printf("%.1f %.1f\n", float1 + float2, float1 - float2);
    
    return 0;
}
