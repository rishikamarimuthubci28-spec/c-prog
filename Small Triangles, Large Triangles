
#include <stdlib.h>
#include <math.h>

struct triangle
{
	int a;
	int b;
	int c;
};

typedef struct triangle triangle;
// Helper function to calculate square of the area multiplied by 16
// This avoids floating point inaccuracies by keeping all calculations in integers
double get_area_metric(triangle t) {
    double a = t.a;
    double b = t.b;
    double c = t.c;
    // Heron's formula squared and multiplied by 16: (a+b+c)*(a+b-c)*(a+c-b)*(b+c-a)
    return (a + b + c) * (a + b - c) * (a + c - b) * (b + c - a);
}

void sort_by_area(triangle* tr, int n) {
    // Bubble sort algorithm to sort the triangles by area
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (get_area_metric(tr[j]) > get_area_metric(tr[j + 1])) {
                // Swap the triangle structures
                triangle temp = tr[j];
                tr[j] = tr[j + 1];
                tr[j + 1] = temp;
            }
        }
    }
}


int main()
{
	int n;
	scanf("%d", &n);
	triangle *tr = malloc(n * sizeof(triangle));
	for (int i = 0; i < n; i++) {
		scanf("%d%d%d", &tr[i].a, &tr[i].b, &tr[i].c);
	}
	sort_by_area(tr, n);
	for (int i = 0; i < n; i++) {
		printf("%d %d %d\n", tr[i].a, tr[i].b, tr[i].c);
	}
	return 0;
}
